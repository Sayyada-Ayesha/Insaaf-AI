# Rollback checkpoints are local snapshots; they are never committed or deployed.
.checkpoint_*/

# Source PDFs/images quarantined in the repo root during corpus harvesting. They
# are provenance copies on this machine, not runtime assets.
_gcu_dl_*

# Dated RAG index backups (~87 MB) are local safety copies. The live indexes
# (rag_index.json, local_vectors.json, islamic_index.json) remain committed
# because the deployed backend retrieves from them at start-up.
rag/indexes/*.backup_*.json

# Local snapshot copies at the repo root — no server code reads them, so they
# stay on this machine instead of adding ~66 MB to a deployed clone.
/backups/
