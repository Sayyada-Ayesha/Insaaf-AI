# ============================================
# Insaaf AI - Environment Configuration
# ============================================

# AI_PROVIDER: Determines which LLM acts as the primary provider
# Options: insaaf (INSAaf-owned local model, corpus-grounded, no third-party API),
# Default: insaaf
# Part C migration: 'insaaf' routes generation through the owned-model composer
# (server/ownedModel.js) and returns an empty online chain, so no external
# AI provider is called and none is selectable.
AI_PROVIDER="insaaf"

# INSAF_MODEL: Label for the INSAaf-owned model when AI_PROVIDER=insaaf.
INSAF_MODEL="insaaf-digital-lawyer-v1"


# ============================================
# Answer generation transport (server-side only)
# ============================================
# INSAF_MODEL_PROVIDER selects what generates answer text:
#   deterministic  (default) the corpus composer — no model weights are used
#   cloudflare     Cloudflare Workers AI REST API (hosted general model, NOT the
#                  fine-tuned Qwen2.5 adapter); needs the three CLOUDFLARE_* values
#   gradio         the Hugging Face ZeroGPU Space in hf-space/ (official @gradio/client)
#   lora-service   the private Python service in training/inference/
# Leave it unset (or deterministic) until one real smoke-test generation through
# the selected transport has passed. Every credential here is server-side only and
# has no VITE_ prefix: it must never reach the browser bundle.
INSAF_MODEL_PROVIDER="deterministic"

# CLOUDFLARE_ACCOUNT_ID: dashboard → Workers & Pages → Account ID.
CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN: Workers AI — Read (or Edit) token. Dashboard only; leave empty here.
CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_MODEL_ID: Workers AI model id. Defaults to @cf/qwen/qwen3.8-27b.
CLOUDFLARE_MODEL_ID="@cf/qwen/qwen3.8-27b"

# HF_SPACE_ID: "owner/space-name" of the private ZeroGPU inference Space.
HF_SPACE_ID=""
# HF_TOKEN: fill in on the server dashboard only; leave empty in this file.
HF_TOKEN=""
# INSAF_MODEL_TIMEOUT_MS: hard cap for one provider call (5s-300s locally). Vercel
# Hobby caps functions at 60s, so on Vercel this is clamped to 50s automatically.
INSAF_MODEL_TIMEOUT_MS="45000"



# ============================================
# Voice / Speech (Feature 2) — NO KEY REQUIRED
# ============================================
# Voice uses the browser Web Speech API (SpeechRecognition + SpeechSynthesis) and
# the operating system's installed voices. There is no external speech provider and
# nothing to configure here; unsupported browsers fall back to text mode.

# APP_URL: Optional application URL for production.
APP_URL="MY_APP_URL"
