# ============================================
# Insaaf AI - Environment Configuration
# ============================================

# AI_PROVIDER: Determines which LLM acts as the primary provider
# Options: insaaf (INSAaf-owned local model, corpus-grounded, no third-party API),
# Default: insaaf
# Part C migration: 'insaaf' routes generation through the owned-model composer
# (server/ownedModel.js) and returns an empty online chain, so no external
# AI provider is called and none is selectable.
AI_PROVIDER="insaaf"

# INSAF_MODEL: Label for the INSAaf-owned model when AI_PROVIDER=insaaf.
INSAF_MODEL="insaaf-digital-lawyer-v1"



# ============================================
# Voice / Speech (Feature 2) — NO KEY REQUIRED
# ============================================
# Voice uses the browser Web Speech API (SpeechRecognition + SpeechSynthesis) and
# the operating system's installed voices. There is no external speech provider and
# nothing to configure here; unsupported browsers fall back to text mode.

# APP_URL: Optional application URL for production.
APP_URL="MY_APP_URL"
