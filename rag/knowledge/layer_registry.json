  "layerDefinitions": [
    {
      "layer": "A",
      "name": "Pakistan Legal Knowledge",
      "scope": "Constitution, federal/provincial statutes, rules, regulations, amendments, subordinate legislation; provision-level exact text/digests."
    },
    {
      "layer": "B",
      "name": "Pakistan Civic / Citizen Knowledge",
      "scope": "Citizenship, NADRA/CNIC, passports, voting/elections, citizen complaints, government offices, ombudsman, commissions, legal aid, emergency services, public-service processes."
    },
    {
      "layer": "C",
      "name": "Pakistan History / Institutional Knowledge",
      "scope": "Creation of Pakistan, constitutional developments (Objectives Resolution, 1956/1962/1973), institutions of state, major national legal milestones."
    },
    {
      "layer": "D",
      "name": "Overseas Pakistanis / Cross-Border Knowledge",
      "scope": "Pakistanis abroad: consular assistance, travel/visa/immigration, overseas employment, study abroad, foreign courts/authorities, dual nationality, repatriation."
    },
    {
      "layer": "E",
      "name": "Foreigner-in-Pakistan Knowledge",
      "scope": "Foreigners dealing with Pakistan: visa/entry/exit, residence, work/study, business, property restrictions, documentation, consular routing. Never asserts unverified foreign substantive law."
    },
    {
      "layer": "F",
      "name": "Legal Procedures / Practical Workflows",
      "scope": "FIR, bail, remand, trials, appeals, revisions, writs, suits, family proceedings, consumer/labour/cyber complaints, ADR, attestation, consular/official workflows."
    },
    {
      "layer": "G",
      "name": "Case Law / Precedent",
      "scope": "SC/FSC/HC judgments and digests, case reasoning (facts/issues/holding/principle), similarity handling without fabricated outcomes."
    },
    {
      "layer": "H",
      "name": "Legal Documents / Drafting",
      "scope": "Document taxonomy, structures, mandatory/optional fields, complete-prose drafting, OCR-to-draft, draft editing, EN + Urdu Script formal output."
    },
    {
      "layer": "I",
      "name": "INSAaf App Knowledge",
      "scope": "Actual app features/routes: AI Consultant/Chat, Legal Agent, Library, Analyzer/OCR, Drafter, Legal Aid, Lawyers, Emergency, My Vault, settings/language/voice, source/Read More, cross-border mode."
    },
    {
      "layer": "J",
      "name": "Safety / Scope / Uncertainty Behavior",
      "scope": "Refusal rules, no fabrication (citations/sections/deadlines/fees/contacts/foreign rules), jurisdiction clarification, general-information vs advice, incorrect/misstated questions, out-of-scope politeness."
    }
  ],
